{{> layout/header}}
<div class="container p5 flex-grow-1">
    {{#boardList}}
        <div class="card mb-3">
            <div class="card-body">
                <h4 class="card-title-mb-3">{{title}}</h4>
                <!-- 머스태치 문법은 기본적으로 getter 가져오고  get은 탈락 가능  -->
